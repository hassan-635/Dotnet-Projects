@model StudentManagementForLearningDTOs.DTOs.CreateStudentDto

<h1>Add Student</h1>

<form asp-action="AddStudent" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Age</label>
        <input asp-for="Age" type="number" />
    </div>

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <div>
        <label>Semester</label>
        <input asp-for="Semester" type="number" />
    </div>

    <button type="submit">Add Student</button>

</form>