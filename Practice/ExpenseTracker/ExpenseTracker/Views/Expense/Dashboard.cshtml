@model List<ExpenseTracker.DTOs.ExpenseDTO>;

<h1>Expense Tracker</h1>
<hr />

@if(Model.Count == 0)
{
    <p>No Excpense Availabe....</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Amount</th>
                <th>Category</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>@expense.Title</td>
                    <td>@expense.Amount</td>
                    <td>@expense.Category</td>
                    <td>@expense.Date</td>
                </tr>
            }
        </tbody>
    </table>
}