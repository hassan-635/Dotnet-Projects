@model BookManagement.DTOs.BookDto;

<h1>Book Update</h1>

<form asp-controller="Book" asp-action="Update" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>
    <div>
        <label>Author</label>
        <input asp-for="Author" />
    </div>
    <div>
        <label>Price</label>
        <input asp-for="Price" />
    </div>
    <button type="submit">
        Update Book
    </button>
</form>