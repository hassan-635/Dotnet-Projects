@model List<BookManagement.DTOs.BookDto>;

<h1>Books</h1>

<a asp-controller="Book" asp-action="Create">Create Book</a>
<a asp-controller="Book" asp-action="GetById">Search Book By Id</a>

@if(Model.Count==0)
{
    <p>No Books Available....</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Price</td>
                </tr>
            }
        </tbody>
    </table>
}