@model BookManagement.DTOs.BookDto;

<h1>Book Details</h1>

@if(Model == null)
{
    <p>Book Not Found...</p>
}
else
{
    <table border="1">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Id</td>
                <td>@Model.Title</td>
                <td>@Model.Author</td>
                <td>@Model.Price</td>
            </tr>
        </tbody>
    </table>
}